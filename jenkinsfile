pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 45, unit: 'MINUTES')
    }

    parameters {
        choice(
            name: 'UPDATE_TARGET',
            choices: ['ENVIRONMENT', 'NODE'],
            description: 'Configuration to update'
        )

        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'stage', 'uat', 'prod'],
            description: 'Environment JSON file'
        )

        choice(
            name: 'NODE',
            choices: ['dev', 'stage', 'uat', 'prod'],
            description: 'Node JSON file'
        )

        string(
            name: 'ENV_APPNAME',
            defaultValue: 'myapp',
            description: 'Application name'
        )

        string(
            name: 'ENV_VERSION',
            defaultValue: '2.0.0',
            description: 'Application version'
        )

        string(
            name: 'ENV_REPLICAS',
            defaultValue: '1',
            description: 'Positive replica count'
        )

        choice(
            name: 'ENV_LOGLEVEL',
            choices: ['INFO', 'DEBUG', 'WARN', 'ERROR'],
            description: 'Application log level'
        )

        string(
            name: 'NODE_NAME',
            defaultValue: 'node-01',
            description: 'Node name'
        )

        choice(
            name: 'NODE_TYPE',
            choices: ['worker', 'control-plane'],
            description: 'Node type'
        )

        string(
            name: 'NODE_REGION',
            defaultValue: 'us-east-1',
            description: 'Node region'
        )

        string(
            name: 'NODE_AZ',
            defaultValue: 'us-east-1a',
            description: 'Availability zone'
        )

        choice(
            name: 'BRANCH_MODE',
            choices: ['CREATE_NEW', 'USE_EXISTING'],
            description: 'Create a new branch or update an existing branch'
        )

        string(
            name: 'NEW_BRANCH_NAME',
            defaultValue: 'feature/config-update-new',
            description: 'Branch to create when CREATE_NEW is selected'
        )

        string(
            name: 'EXISTING_BRANCH_NAME',
            defaultValue: 'feature/config-update',
            description: 'Existing branch to update'
        )

        booleanParam(
            name: 'PUBLISH_CHANGES',
            defaultValue: true,
            description: 'Push branch, create a pull request, and merge it'
        )
    }

    environment {
        GITHUB_OWNER       = 'Sunith3210'
        GITHUB_REPO        = 'jenkins-config-automation-no-check'
        GITHUB_BASE_BRANCH = 'main'

        NEXUS_URL          = 'http://32.195.67.231:8081/repository/jenkins-config-artifacts'
        SONAR_PROJECT_KEY  = 'jenkins-config-automation'
    }

    stages {
        stage('Checkout main') {
            steps {
                deleteDir()

                git branch: 'main',
                    credentialsId: 'github-creds',
                    url: 'https://github.com/Sunith3210/jenkins-config-automation-no-check.git'
            }
        }

        stage('Validate parameters') {
            steps {
                script {
                    if (!(params.UPDATE_TARGET in ['ENVIRONMENT', 'NODE'])) {
                        error('Invalid configuration target.')
                    }

                    if (!(params.BRANCH_MODE in ['CREATE_NEW', 'USE_EXISTING'])) {
                        error('Invalid branch mode.')
                    }

                    if (!(params.ENVIRONMENT in ['dev', 'stage', 'uat', 'prod'])) {
                        error('Invalid environment.')
                    }

                    if (!(params.NODE in ['dev', 'stage', 'uat', 'prod'])) {
                        error('Invalid node environment.')
                    }

                    if (!(params.ENV_LOGLEVEL in ['INFO', 'DEBUG', 'WARN', 'ERROR'])) {
                        error('Invalid log level.')
                    }

                    if (!(params.NODE_TYPE in ['worker', 'control-plane'])) {
                        error('Invalid node type.')
                    }

                    if (!(params.ENV_REPLICAS ==~ '[1-9][0-9]*')) {
                        error('Replicas must be a positive integer.')
                    }

                    if (!(params.ENV_APPNAME ==~ '[A-Za-z0-9][A-Za-z0-9._-]*')) {
                        error('Invalid application name.')
                    }

                    if (!(params.ENV_VERSION ==~ '[A-Za-z0-9][A-Za-z0-9._+-]*')) {
                        error('Invalid application version.')
                    }

                    if (!(params.NODE_NAME ==~ '[A-Za-z0-9][A-Za-z0-9._-]*')) {
                        error('Invalid node name.')
                    }

                    if (!(params.NODE_REGION ==~ '[A-Za-z0-9-]+') ||
                        !(params.NODE_AZ ==~ '[A-Za-z0-9-]+')) {
                        error('Invalid node region or availability zone.')
                    }

                    env.ACTIVE_BRANCH_NAME = (
                        params.BRANCH_MODE == 'CREATE_NEW'
                        ? params.NEW_BRANCH_NAME.trim()
                        : params.EXISTING_BRANCH_NAME.trim()
                    )

                    if (!(env.ACTIVE_BRANCH_NAME ==~
                        '[A-Za-z0-9][A-Za-z0-9._/-]*')) {
                        error('Invalid Git branch name.')
                    }

                    if (env.ACTIVE_BRANCH_NAME in ['main', 'master']) {
                        error('Never use main or master as the update branch.')
                    }

                    if (env.ACTIVE_BRANCH_NAME.endsWith('/') ||
                        env.ACTIVE_BRANCH_NAME.endsWith('.') ||
                        env.ACTIVE_BRANCH_NAME.contains('..') ||
                        env.ACTIVE_BRANCH_NAME.contains('//') ||
                        env.ACTIVE_BRANCH_NAME.contains('@{') ||
                        env.ACTIVE_BRANCH_NAME.endsWith('.lock')) {
                        error('Invalid Git branch name.')
                    }

                    env.TARGET_FILE = (
                        params.UPDATE_TARGET == 'ENVIRONMENT'
                        ? "environment/${params.ENVIRONMENT}.json"
                        : "node/${params.NODE}.json"
                    )

                    echo "Update target: ${params.UPDATE_TARGET}"
                    echo "Branch mode: ${params.BRANCH_MODE}"
                    echo "Selected branch: ${env.ACTIVE_BRANCH_NAME}"
                    echo "Target file: ${env.TARGET_FILE}"
                }

                sh '''
                    set -eu
                    test -f "$TARGET_FILE"
                    python3 -m json.tool "$TARGET_FILE" >/dev/null
                    echo "Configuration JSON is valid."
                '''
            }
        }

        stage('Prepare selected branch') {
            steps {
                sh '''
                    set -eu

                    git config user.name "Jenkins"
                    git config user.email "jenkins@example.com"

                    git fetch origin main
                    git checkout -B main origin/main

                    if [ "$BRANCH_MODE" = "CREATE_NEW" ]; then
                        if git ls-remote --exit-code --heads origin \
                            "$ACTIVE_BRANCH_NAME" >/dev/null 2>&1; then
                            echo "ERROR: Branch already exists."
                            echo "Choose another NEW_BRANCH_NAME or select USE_EXISTING."
                            exit 1
                        fi

                        git checkout -b "$ACTIVE_BRANCH_NAME" origin/main
                        echo "Created new branch from main."
                    else
                        if ! git ls-remote --exit-code --heads origin \
                            "$ACTIVE_BRANCH_NAME" >/dev/null 2>&1; then
                            echo "ERROR: Selected remote branch does not exist."
                            exit 1
                        fi

                        git fetch origin "$ACTIVE_BRANCH_NAME"

                        git checkout -B "$ACTIVE_BRANCH_NAME" \
                            "origin/$ACTIVE_BRANCH_NAME"

                        git merge --no-edit origin/main
                        echo "Existing branch prepared."
                    fi

                    echo "Active branch: $ACTIVE_BRANCH_NAME"
                '''
            }
        }

        stage('Update selected JSON') {
            steps {
                withEnv([
                    "APP_NAME=${params.ENV_APPNAME}",
                    "APP_VERSION=${params.ENV_VERSION}",
                    "APP_REPLICAS=${params.ENV_REPLICAS}",
                    "APP_LOGLEVEL=${params.ENV_LOGLEVEL}",
                    "CONFIG_NODE_NAME=${params.NODE_NAME}",
                    "CONFIG_NODE_TYPE=${params.NODE_TYPE}",
                    "CONFIG_REGION=${params.NODE_REGION}",
                    "CONFIG_AZ=${params.NODE_AZ}",
                    "CONFIG_ENVIRONMENT=${params.ENVIRONMENT}",
                    "CONFIG_NODE_ENV=${params.NODE}"
                ]) {
                    sh '''
                        set -eu

                        python3 <<'PY'
import json
import os

target = os.environ["TARGET_FILE"]

with open(target, encoding="utf-8") as f:
    data = json.load(f)

if os.environ["UPDATE_TARGET"] == "ENVIRONMENT":
    data["environment"] = os.environ["CONFIG_ENVIRONMENT"]
    data["appName"] = os.environ["APP_NAME"]
    data["version"] = os.environ["APP_VERSION"]
    data["replicas"] = int(os.environ["APP_REPLICAS"])
    data["logLevel"] = os.environ["APP_LOGLEVEL"]
else:
    data["environment"] = os.environ["CONFIG_NODE_ENV"]
    data["nodeName"] = os.environ["CONFIG_NODE_NAME"]
    data["nodeType"] = os.environ["CONFIG_NODE_TYPE"]
    data["region"] = os.environ["CONFIG_REGION"]
    data["availabilityZone"] = os.environ["CONFIG_AZ"]

with open(target, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=2)
    f.write("\\n")

with open(target, encoding="utf-8") as f:
    json.load(f)

print("Updated and validated:", target)
PY

                        git diff -- "$TARGET_FILE"
                    '''
                }
            }
        }

        stage('SonarQube analysis') {
            steps {
                script {
                    def scannerHome = tool 'sonar_scanner'

                    withSonarQubeEnv('devops_project') {
                        sh """
                            set -eu
                            '${scannerHome}/bin/sonar-scanner' \\
                              -Dsonar.projectKey='${SONAR_PROJECT_KEY}' \\
                              -Dsonar.projectName='${SONAR_PROJECT_KEY}' \\
                              -Dsonar.sources=environment,node \\
                              -Dsonar.scm.provider=git
                        """
                    }
                }
            }
        }

        stage('Wait for SonarQube quality gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Package selected configuration') {
            steps {
                sh '''
                    set -eu
                    mkdir -p dist

                    FILE="dist/config-${UPDATE_TARGET}-${BUILD_NUMBER}.tar.gz"

                    tar -czf "$FILE" "$TARGET_FILE"
                    tar -tzf "$FILE"

                    echo "Created artifact: $FILE"
                '''
            }
        }

        stage('Upload artifact to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-upload-creds',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu

                        FILE="dist/config-${UPDATE_TARGET}-${BUILD_NUMBER}.tar.gz"
                        URL="${NEXUS_URL}/${UPDATE_TARGET}/${BUILD_NUMBER}/$(basename "$FILE")"

                        CODE=$(curl -sS -o /dev/null -w "%{http_code}" \\
                            -u "$NEXUS_USER:$NEXUS_PASS" \\
                            -T "$FILE" "$URL")

                        echo "Nexus upload HTTP status: $CODE"

                        case "$CODE" in
                            200|201|204) ;;
                            *)
                                echo "ERROR: Nexus upload failed."
                                exit 1
                                ;;
                        esac

                        CODE=$(curl -sS -o /dev/null -w "%{http_code}" \\
                            -u "$NEXUS_USER:$NEXUS_PASS" "$URL")

                        echo "Nexus read-back HTTP status: $CODE"
                        test "$CODE" = "200"
                    '''
                }

                archiveArtifacts artifacts: 'dist/*.tar.gz', fingerprint: true
            }
        }

        stage('Prepare Git change') {
            steps {
                sh '''
                    set -eu

                    git add -- "$TARGET_FILE"

                    if ! git diff --cached --quiet; then
                        git commit -m "Update ${UPDATE_TARGET} configuration (build ${BUILD_NUMBER})"
                    else
                        echo "No new configuration changes to commit."
                    fi
                '''
            }
        }

        stage('Push branch, create PR, and merge') {
            when {
                expression { params.PUBLISH_CHANGES }
            }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-creds',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu

                        AUTH=$(printf '%s' "$GITHUB_USER:$GITHUB_TOKEN" \\
                            | base64 | tr -d '\\n')

                        git -c http.extraheader="AUTHORIZATION: basic $AUTH" \\
                            push origin "HEAD:refs/heads/$ACTIVE_BRANCH_NAME"

                        git fetch origin main

                        if git diff --quiet origin/main HEAD; then
                            echo "No differences from main."
                            echo "No pull request or merge is necessary."
                            exit 0
                        fi

                        export GITHUB_BASE_BRANCH
                        export ACTIVE_BRANCH_NAME

                        python3 <<'PY'
import json
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

owner = os.environ["GITHUB_OWNER"]
repo = os.environ["GITHUB_REPO"]
base = os.environ["GITHUB_BASE_BRANCH"]
branch = os.environ["ACTIVE_BRANCH_NAME"]
token = os.environ["GITHUB_TOKEN"]
build_number = os.environ["BUILD_NUMBER"]

api = "https://api.github.com"

headers = {
    "Authorization": "Bearer " + token,
    "Accept": "application/vnd.github+json",
    "X-GitHub-Api-Version": "2022-11-28",
    "Content-Type": "application/json",
}

def request(url, method="GET", payload=None):
    data = None if payload is None else json.dumps(payload).encode()
    req = urllib.request.Request(
        url,
        data=data,
        headers=headers,
        method=method
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as response:
            raw = response.read().decode()
            return response.status, json.loads(raw) if raw else {}
    except urllib.error.HTTPError as exc:
        raw = exc.read().decode()
        try:
            body = json.loads(raw)
        except Exception:
            body = {"message": raw}
        raise RuntimeError(
            f"GitHub API HTTP {exc.code}: {body}"
        ) from exc

def endpoint(path):
    return api + path

try:
    # 1. Reuse an existing open PR if any, otherwise create one.
    query = urllib.parse.urlencode({
        "state": "open",
        "head": owner + ":" + branch,
        "base": base,
        "per_page": "100",
    })

    _, pulls = request(
        endpoint(f"/repos/{owner}/{repo}/pulls?{query}")
    )

    if pulls:
        pr = pulls[0]
        print("Reusing pull request:", pr["html_url"])
    else:
        _, pr = request(
            endpoint(f"/repos/{owner}/{repo}/pulls"),
            "POST",
            {
                "title": f"Automated configuration update - build {build_number}",
                "body": (
                    "Configuration update created by Jenkins after "
                    "JSON validation, SonarQube quality gate, and Nexus "
                    "upload succeeded."
                ),
                "head": branch,
                "base": base,
            },
        )
        print("Created pull request:", pr["html_url"])

    number = pr["number"]
    head_sha = pr["head"]["sha"]

    print("Pull request:", pr["html_url"])
    print("Head commit:", head_sha)

    # 2. Wait briefly for GitHub to compute mergeability.
    for attempt in range(1, 11):
        _, latest = request(
            endpoint(f"/repos/{owner}/{repo}/pulls/{number}")
        )
        mergeable = latest.get("mergeable")
        state = latest.get("state")

        if state != "open":
            raise RuntimeError(
                f"Pull request is not open (state={state})."
            )

        if mergeable is True:
            print("PR is mergeable.")
            break

        if mergeable is False:
            raise RuntimeError(
                "GitHub reports the PR is not mergeable. "
                "Check for conflicts or ruleset blocks."
            )

        print(f"Waiting for mergeability (attempt {attempt})...")
        time.sleep(3)
    else:
        raise RuntimeError("Timed out waiting for PR mergeability.")

    # 3. Merge the PR directly.
    _, result = request(
        endpoint(f"/repos/{owner}/{repo}/pulls/{number}/merge"),
        "PUT",
        {"merge_method": "squash"},
    )

    if result.get("merged") is not True:
        raise RuntimeError(
            "GitHub did not confirm the merge. "
            + json.dumps(result)
        )

    print("RESULT: MERGE SUCCESSFUL.")
    print("Merged PR:", pr["html_url"])
    print("GitHub message:", result.get("message", "Merged"))

except Exception as exc:
    print("ERROR:", str(exc), file=sys.stderr)
    sys.exit(1)
PY
                    '''
                }
            }
        }

        stage('Report result') {
            steps {
                script {
                    if (!params.PUBLISH_CHANGES) {
                        echo 'PUBLISH_CHANGES=false: no push or merge operation was requested.'
                    } else {
                        echo 'Publish and merge requested. Check the previous stage for the result.'
                    }
                }
            }
        }
    }

    post {
        success {
            echo "PIPELINE SUCCESS: ${params.UPDATE_TARGET}"
            echo "Branch: ${env.ACTIVE_BRANCH_NAME ?: 'not selected'}"
            echo "Repository: ${env.GITHUB_OWNER}/${env.GITHUB_REPO}"
        }

        failure {
            echo 'PIPELINE FAILED.'
            echo 'Check the failed stage and console output.'
        }

        aborted {
            echo 'PIPELINE ABORTED. No successful merge is claimed.'
        }

        always {
            cleanWs(deleteDirs: true, notFailBuild: true)
        }
    }
}
